    {
      "name": "05 - Ranges (CRUD)",
      "item": [
        {
          "name": "POST /ranges (create)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Every entry has Key and Value bounds', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body[0].Ranges).to.be.an('array').with.length.above(0);",
                  "    body[0].Ranges.forEach(function (r) {",
                  "        pm.expect(r).to.have.all.keys('Key', 'Value');",
                  "        pm.expect(r.Key <= r.Value).to.be.true;",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "[\n  { \"Id\": {{rangeId}}, \"Data\": \"BRUCE WAYNE\", \"DataType\": \"N\" }\n]",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/ranges",
              "host": ["{{baseUrl}}"],
              "path": ["ranges"]
            }
          }
        },
        {
          "name": "GET /ranges/{id}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Record round-trips', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body[0]).to.include({ Id: Number(pm.environment.get('rangeId')), Data: 'BRUCE WAYNE', DataType: 'N' });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ranges/{{rangeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ranges", "{{rangeId}}"]
            }
          }
        },
        {
          "name": "PATCH /ranges/{id}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('DataType changed to A', function () {",
                  "    pm.expect(pm.response.json()[0].DataType).to.eql('A');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
