{
  "info": {
    "_postman_id": "9d1c8f7e-6a3b-4b0e-b6a2-2c9f7a2b5501",
    "name": "Test-API - QA Workshop",
    "description": "Automated Postman collection covering health, CRUD, validation, idempotency, buggy endpoints, and two data-driven flows (matchscore + error status codes) for the FastAPI Test-API. Requires environment 'Test-API - Local'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Health & Metadata",
      "item": [
        {
          "name": "GET /healthcheck",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is a JSON array with one item', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array').with.lengthOf(1);",
                  "});",
                  "pm.test('Reports Healthy', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body[0]).to.have.property('status', 'Healthy');",
                  "    pm.expect(body[0]).to.have.property('message', 'Health check passed');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthcheck",
              "host": ["{{baseUrl}}"],
              "path": ["healthcheck"]
            }
          }
        },
        {
          "name": "GET /version",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Version metadata present', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array').with.lengthOf(1);",
                  "    pm.expect(body[0]).to.have.property('name', 'Test-API');",
                  "    pm.expect(body[0]).to.have.property('version').that.is.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/version",
              "host": ["{{baseUrl}}"],
              "path": ["version"]
            }
          }
        },
        {
          "name": "GET /stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Exposes counts for all three stores', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array').with.lengthOf(1);",
                  "    ['keys', 'ranges', 'matchscore'].forEach(function (store) {",
                  "        pm.expect(body[0]).to.have.property(store).that.is.a('number');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stats",
              "host": ["{{baseUrl}}"],
              "path": ["stats"]
            }
          }
        }
      ]
    },
