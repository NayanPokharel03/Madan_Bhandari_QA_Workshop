    {
      "name": "03 - Keys (Positive CRUD)",
      "item": [
        {
          "name": "POST /keys (create)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Returns array with generated Keys', function () {",
                  "    pm.expect(body).to.be.an('array').with.lengthOf(1);",
                  "    pm.expect(body[0]).to.have.property('Keys').that.is.an('array').with.length.above(0);",
                  "    pm.expect(body[0]).to.include({ Id: Number(pm.environment.get('keyId')), Data: 'BRUCE WAYNE', DataType: 'N' });",
                  "});",
                  "pm.collectionVariables.set('lastKeys', JSON.stringify(body[0].Keys));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "[\n  { \"Id\": {{keyId}}, \"Data\": \"BRUCE WAYNE\", \"DataType\": \"N\" }\n]",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/keys",
              "host": ["{{baseUrl}}"],
              "path": ["keys"]
            }
          }
        },
        {
          "name": "POST /keys (idempotent re-run, same payload)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 on repeat with identical payload', function () { pm.response.to.have.status(201); });",
                  "pm.test('Generated Keys are stable across identical re-posts', function () {",
                  "    const body = pm.response.json();",
                  "    const previous = JSON.parse(pm.collectionVariables.get('lastKeys') || '[]');",
                  "    pm.expect(body[0].Keys).to.eql(previous);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
