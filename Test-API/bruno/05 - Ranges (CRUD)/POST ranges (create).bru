meta {
  name: POST /ranges (create)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/ranges
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  [
    { "Id": {{rangeId}}, "Data": "BRUCE WAYNE", "DataType": "N" }
  ]
}

tests {
  test('Status is 201', function () {
    expect(res.getStatus()).to.equal(201);
  });
  test('Every entry has Key and Value bounds', function () {
    const body = res.getBody();
    expect(body[0].Ranges).to.be.an('array').with.length.above(0);
    body[0].Ranges.forEach(function (r) {
      expect(r).to.have.all.keys('Key', 'Value');
      expect(r.Key <= r.Value).to.be.true;
    });
  });
}
