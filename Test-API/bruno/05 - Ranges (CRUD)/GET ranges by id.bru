meta {
  name: GET /ranges/{id}
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/ranges/{{rangeId}}
  body: none
  auth: none
}

tests {
  test('Status is 200', function () {
    expect(res.getStatus()).to.equal(200);
  });
  test('Record round-trips', function () {
    const body = res.getBody();
    expect(body[0]).to.include({ Id: Number(bru.getEnvVar('rangeId')), Data: 'BRUCE WAYNE', DataType: 'N' });
  });
}
