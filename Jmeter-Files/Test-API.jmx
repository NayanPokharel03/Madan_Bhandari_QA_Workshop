              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Score Extractor" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">ms-score</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$[0].Score</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers"></stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Decision Extractor" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">ms-decision</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$[0].Decision</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers"></stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">AssertValues(&quot;201&quot;,vars.get(&quot;captured_responseCode&quot;),&quot; The response code is as expected&quot;,&quot; The response code is not as expected&quot;);
AssertValues(vars.get(&quot;expectedDecision&quot;),vars.get(&quot;ms-decision&quot;),&quot; The Decision matches the CSV expectation&quot;,&quot; The Decision does not match the CSV expectation&quot;);
int actualScore = 0; int minScore = 0;
try { actualScore = Integer.parseInt(vars.get(&quot;ms-score&quot;)); } catch(Exception e) {}
try { minScore = Integer.parseInt(vars.get(&quot;expectedMinScore&quot;)); } catch(Exception e) {}
if(actualScore &lt; minScore){
 vars.put(&quot;AssertionFailure&quot;,&quot;true&quot;);
 AssertionResult.setFailure(true);
 String prevMsg = vars.get(&quot;FailureMsg&quot;) == null ? &quot;&quot; : vars.get(&quot;FailureMsg&quot;);
 vars.put(&quot;FailureMsg&quot;, prevMsg + &quot;\nScore &quot; + actualScore + &quot; is below the CSV minimum &quot; + minScore + &quot;\n&quot;);
}

logErrorMessage();

public void logErrorMessage(){
 if(vars.get(&quot;AssertionFailure&quot;) != null &amp;&amp; vars.get(&quot;AssertionFailure&quot;).equals(&quot;true&quot;)){
 AssertionResult.setFailureMessage(vars.get(&quot;FailureMsg&quot;));
 }
 vars.put(&quot;FailureMsg&quot;,&quot;&quot;);
 vars.put(&quot;AssertionFailure&quot;,&quot;&quot;);
}

public void AssertValues(String Expected, String Actual, String PassMessage, String FailureMessage){
 if(Expected != null &amp;&amp; Expected.equals(Actual)){
 log.info(PassMessage);
 }
 else{
 vars.put(&quot;AssertionFailure&quot;,&quot;true&quot;);
 AssertionResult.setFailure(true);
 String prevMsg = vars.get(&quot;FailureMsg&quot;) == null ? &quot;&quot; : vars.get(&quot;FailureMsg&quot;);
 vars.put(&quot;FailureMsg&quot;, prevMsg + &quot;\n****ASSERTION FAILURE****** \n&quot; + FailureMessage + &quot; || EXPECTED: &quot; + Expected + &quot; || ACTUAL: &quot; + Actual + &quot;\n&quot;);
 log.info(FailureMessage);
 }
}</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
