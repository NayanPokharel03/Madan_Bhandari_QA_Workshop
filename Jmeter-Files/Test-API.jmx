              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">workshop</stringProp>
                  <stringProp name="Header.value">MadanBhandari</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Response Code Assertion" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">16</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Response Code and Body" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">vars.put(&apos;captured_responseCode&apos;, prev.getResponseCode());
vars.put(&apos;captured_responseBody&apos;, prev.getResponseDataAsString());</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Health Check Message Extractor" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">hc-message</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$[0].message</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers"></stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Health Check Status Extractor" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">hc-status</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$[0].status</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers"></stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">AssertValues(&quot;200&quot;,vars.get(&quot;captured_responseCode&quot;),&quot; The response code is as expected&quot;, &quot; The response code is not as expected &quot;);
AssertValues(&quot;Health check passed&quot;,vars.get(&quot;hc-message&quot;),&quot; The message is as expected&quot;, &quot; The environment is not as expected &quot;);
AssertValues(&quot;Healthy&quot;,vars.get(&quot;hc-status&quot;),&quot; The health check status shows healthy&quot;, &quot; The health check status failed&quot;);

logErrorMessage();

public void logErrorMessage(){
 if(vars.get(&quot;AssertionFailure&quot;).equals(&quot;true&quot;)){
 log.info(&quot;Entered Failure Check&quot;);
 log.info(vars.get(&quot;FailureMsg&quot;));
 AssertionResult.setFailureMessage(vars.get(&quot;FailureMsg&quot;));
 }
 vars.put(&quot;FailureMsg&quot;,&quot;&quot;);
 vars.put(&quot;AssertionFailure&quot;,&quot;&quot;);
}

public void AssertValues(String Expected, String Actual, String PassMessage, String FailureMessage){
 if(Expected.equals(Actual)){
 log.info(&quot;****Assertion Successful****&quot;);
 log.info(&quot;Actual: &quot;+Actual+&quot; Expected: &quot;+Expected);
 log.info(PassMessage +&quot;\n&quot;);

 }
 else{
 vars.put(&quot;isJmeterExecutionStatus&quot;,&quot;FAILED Status : &quot;);

 vars.put(&quot;AssertionFailure&quot;,&quot;true&quot;); 
 AssertionResult.setFailure(true);
 //vars.put(&quot;FailureMsg&quot;,vars.get(&quot;FailureMsg&quot;) + &quot;\n****ASSERTION FAILURE****** \n&quot;+FailureMessage + &quot; || EXPECTED: &quot;+ Expected + &quot; || ACTUAL: &quot;+Actual + &quot;\n&quot;); 
 //vars.put(&quot;FailureMsg&quot;,&quot; ***** Failed Failed Failed*******&quot;); 
 vars.put(&quot;FailureMsg&quot;,vars.get(&quot;FailureMsg&quot;) + &quot;\n****ASSERTION FAILURE****** \n&quot;+FailureMessage + &quot; || EXPECTED: &quot;+ Expected + &quot; || ACTUAL: &quot;+Actual + &quot;\n&quot;); 


 log.info(&quot;:::: FailureMsg&quot;+vars.get(&quot;FailureMsg&quot;));

 log.info(&quot;****ASSERTION FAILURE******&quot;);
 // AssertionResult.setFailureMessage(&quot;****Assertion Failure****** &quot;+FailureMessage + &quot; Expected: &quot;+ Expected + &quot; Actual: &quot;+Actual+&quot;\n&quot;);
 log.info(FailureMessage); 
 log.info(&quot;Actual: &quot;+Actual+&quot; Expected: &quot;+Expected);
 }
 }</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
