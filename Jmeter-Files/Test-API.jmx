              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper;
def body = new JsonSlurper().parseText(vars.get(&quot;captured_responseBody&quot;));
boolean leaks = false;
if(body instanceof List &amp;&amp; body.size() &gt; 0){
 def first = body.get(0);
 leaks = first.containsKey(&quot;storage_path&quot;) || first.containsKey(&quot;debug_token&quot;);
}
if(leaks){
 AssertionResult.setFailure(true);
 AssertionResult.setFailureMessage(&quot;DEFECT: /buggy/echo leaks storage_path or debug_token (information disclosure)&quot;);
} else {
 log.info(&quot;No internal fields leaked&quot;);
}</stringProp>
