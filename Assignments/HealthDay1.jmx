            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

// 1. Get raw response string
def responseText = prev.getResponseDataAsString()

// 2. Log raw response directly
log.info(&quot;=== RAW RESPONSE BODY ===&quot;)
log.info(responseText)

// 3. Parse JSON
def response = new JsonSlurper().parseText(responseText)

// 4. Log formatted/pretty-printed JSON for easy reading
log.info(&quot;=== PARSED JSON STRUCTURE ===&quot;)
log.info(JsonOutput.prettyPrint(responseText))

// 5. Inspect top-level keys/type
if (response instanceof List) {
    log.info(&quot;Response type: JSON Array (Size: ${response.size()})&quot;)
    if (response.size() &gt; 0) {
        log.info(&quot;Keys in first item [0]: &quot; + response[0].keySet())
    }
} else if (response instanceof Map) {
    log.info(&quot;Response type: JSON Object&quot;)
    log.info(&quot;Top-level keys: &quot; + response.keySet())
}</stringProp>
