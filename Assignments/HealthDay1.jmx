public void logErrorMessage() {
if (&quot;true&quot;.equals(vars.get(&quot;AssertionFailure&quot;))) {
log.info(&quot;Entered Failure Check&quot;);
log.info(vars.get(&quot;FailureMsg&quot;));
AssertionResult.setFailureMessage(vars.get(&quot;FailureMsg&quot;));
}


vars.put(&quot;FailureMsg&quot;, &quot;&quot;);
vars.put(&quot;AssertionFailure&quot;, &quot;&quot;);

}

public void AssertValues(String Expected, String Actual,
String PassMessage, String FailureMessage) {


if (Expected.equals(Actual)) {
    log.info(&quot;****Assertion Successful****&quot;);
    log.info(&quot;Actual: &quot; + Actual + &quot; Expected: &quot; + Expected);
    log.info(PassMessage + &quot;\n&quot;);

} else {
    vars.put(&quot;isJmeterExecutionStatus&quot;, &quot;FAILED Status : &quot;);
    vars.put(&quot;AssertionFailure&quot;, &quot;true&quot;);

    AssertionResult.setFailure(true);

    vars.put(&quot;FailureMsg&quot;,
        vars.get(&quot;FailureMsg&quot;) +
        &quot;\n****ASSERTION FAILURE****** \n&quot; +
        FailureMessage +
        &quot; || EXPECTED: &quot; + Expected +
        &quot; || ACTUAL: &quot; + Actual + &quot;\n&quot;
    );

    log.info(&quot;:::: FailureMsg &quot; + vars.get(&quot;FailureMsg&quot;));
    log.info(&quot;****ASSERTION FAILURE******&quot;);
    log.info(FailureMessage);
    log.info(&quot;Actual: &quot; + Actual + &quot; Expected: &quot; + Expected);
}


}
